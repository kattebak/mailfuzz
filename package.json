{
	"name": "@kattebak/mailfuzz",
	"version": "1.0.0",
	"description": "Producing massive amounts of compliant, fuzzy fake emails.",
	"homepage": "https://github.com/kattebak/mailfuzz#readme",
	"bugs": {
		"url": "https://github.com/kattebak/mailfuzz/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kattebak/mailfuzz.git"
	},
	"license": "ISC",
	"publishConfig": {
		"access": "public"
	},
	"author": "",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"mailfuzz": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc && npm run build:schema",
		"build:schema": "tsx src/config/generate-schema.ts",
		"dev": "tsx src/cli.ts",
		"fix": "biome check --write --unsafe .",
		"lint": "biome check --write .",
		"lint:check": "biome check .",
		"test": "npm run typecheck && npm run lint:check && vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"qa:generate": "npm run dev -- generate -c qa.mailfuzz.json",
		"qa:start": "./npm-scripts/qa-start.sh",
		"qa:stop": "./npm-scripts/qa-stop.sh",
		"qa:logs": "./npm-scripts/qa-logs.sh",
		"qa:reset": "./npm-scripts/qa-reset.sh"
	},
	"dependencies": {
		"@faker-js/faker": "^9.3.0",
		"mailparser": "^3.7.2",
		"nodemailer": "^6.9.16",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^22.10.5",
		"@types/nodemailer": "^6.4.17",
		"@vitest/coverage-v8": "^2.1.8",
		"semantic-release": "^25.0.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8",
		"zod-to-json-schema": "^3.25.1"
	},
	"engines": {
		"node": ">=22"
	}
}
